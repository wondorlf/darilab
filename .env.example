# El sitio es 100% estático (output: 'export') y no requiere secretos.
# Estas variables son opcionales:

# Ruta base si el sitio no se sirve en la raíz del dominio
# (GitHub Pages de usuario/repo). En darilabips.com se deja vacío.
#NEXT_PUBLIC_BASE_PATH=/darilab

# Puerto al servir out/ localmente con `npm run start` (por defecto 8383).
#PORT=8383
